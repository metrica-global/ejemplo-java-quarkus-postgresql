{
  "realm": "zonacards",
  "enabled": true,
  "displayName": "Zonacards (entorno local)",
  "sslRequired": "none",
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      {
        "name": "operador",
        "description": "Crea, consulta y anula lotes y gift cards de su tenant"
      },
      {
        "name": "consulta",
        "description": "Solo consulta lotes y gift cards de su tenant"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "zonacards-api",
      "description": "Claims que todo servicio de Zonacards espera: audiencia, tenant, sujeto y nombre de usuario",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audiencia",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "zonacards-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "usuario",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "sujeto",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "lotes:read",
      "description": "Permiso lotes:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "lotes:write",
      "description": "Permiso lotes:write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "lotes:anular",
      "description": "Permiso lotes:anular",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "giftcards:read",
      "description": "Permiso giftcards:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "giftcards:write",
      "description": "Permiso giftcards:write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "giftcards:activar",
      "description": "Permiso giftcards:activar",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "giftcards:anular",
      "description": "Permiso giftcards:anular",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "scopeMappings": [
    {
      "clientScope": "lotes:read",
      "roles": [
        "operador",
        "consulta"
      ]
    },
    {
      "clientScope": "lotes:write",
      "roles": [
        "operador"
      ]
    },
    {
      "clientScope": "lotes:anular",
      "roles": [
        "operador"
      ]
    },
    {
      "clientScope": "giftcards:read",
      "roles": [
        "operador",
        "consulta"
      ]
    },
    {
      "clientScope": "giftcards:write",
      "roles": [
        "operador"
      ]
    },
    {
      "clientScope": "giftcards:activar",
      "roles": [
        "operador"
      ]
    },
    {
      "clientScope": "giftcards:anular",
      "roles": [
        "operador"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "zonacards-cli",
      "name": "Usuarios de demostración (línea de comandos)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "zonacards-api",
        "lotes:read",
        "lotes:write",
        "lotes:anular",
        "giftcards:read",
        "giftcards:write",
        "giftcards:activar",
        "giftcards:anular"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "zonacards-integracion",
      "name": "Sistema externo que integra por API (cuenta de servicio)",
      "enabled": true,
      "publicClient": false,
      "secret": "integracion-local",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "zonacards-api",
        "lotes:read",
        "lotes:write",
        "lotes:anular",
        "giftcards:read",
        "giftcards:write",
        "giftcards:activar",
        "giftcards:anular"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "ana",
      "enabled": true,
      "email": "ana@zonacards.test",
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "Operadora",
      "attributes": {
        "tenant_id": [
          "pe"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "ana",
          "temporary": false
        }
      ],
      "realmRoles": [
        "operador"
      ]
    },
    {
      "username": "luis",
      "enabled": true,
      "email": "luis@zonacards.test",
      "emailVerified": true,
      "firstName": "Luis",
      "lastName": "Consulta",
      "attributes": {
        "tenant_id": [
          "pe"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "luis",
          "temporary": false
        }
      ],
      "realmRoles": [
        "consulta"
      ]
    },
    {
      "username": "eva",
      "enabled": true,
      "email": "eva@zonacards.test",
      "emailVerified": true,
      "firstName": "Eva",
      "lastName": "Operadora",
      "attributes": {
        "tenant_id": [
          "ec"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "eva",
          "temporary": false
        }
      ],
      "realmRoles": [
        "operador"
      ]
    },
    {
      "username": "service-account-zonacards-integracion",
      "enabled": true,
      "serviceAccountClientId": "zonacards-integracion",
      "attributes": {
        "tenant_id": [
          "pe"
        ]
      },
      "realmRoles": [
        "operador"
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"tenant_id\", \"displayName\": \"Tenant (país)\", \"validations\": {\"pattern\": {\"pattern\": \"^[a-z]{2}$\", \"error-message\": \"dos letras minúsculas\"}}, \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}}]}"
          ]
        }
      }
    ]
  }
}
