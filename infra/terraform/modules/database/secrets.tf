# Two PostgreSQL roles per service, each with its own generated password:
#
#   <service>_owner  owns the schema; used only by the migration task
#   <service>_app    DML only, connection limited; used by the deployments that serve it
#
# The values are generated by modules/generated-secrets and exist only in
# Secrets Manager, never in the Terraform state. The bootstrap task reads them
# from there to set the role passwords inside PostgreSQL.
#
# Rotation: increase var.password_version, apply, run the bootstrap task again
# (it is idempotent and re-sets the passwords), then redeploy the services.

module "role_passwords" {
  source = "../generated-secrets"

  secrets = merge(
    {
      for svc in keys(var.services) : "${svc}-owner" => {
        name        = "${var.name_prefix}-${svc}-db-owner-password"
        description = "Password of the ${svc}_owner PostgreSQL role (schema owner). Read only by the migration and bootstrap tasks."
      }
    },
    {
      for svc in keys(var.services) : "${svc}-app" => {
        name        = "${var.name_prefix}-${svc}-db-app-password"
        description = "Password of the ${svc}_app PostgreSQL role (DML only). Read by the deployments that serve ${svc}."
      }
    },
  )

  value_version        = var.password_version
  recovery_window_days = var.secret_recovery_window_days
}

locals {
  owner_password_arns = { for svc in keys(var.services) : svc => module.role_passwords.secret_arns["${svc}-owner"] }
  app_password_arns   = { for svc in keys(var.services) : svc => module.role_passwords.secret_arns["${svc}-app"] }
}
